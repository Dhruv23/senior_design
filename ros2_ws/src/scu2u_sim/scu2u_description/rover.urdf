<?xml version="1.0"?>
<robot name="scu2u_rover">

  <link name="base_link"/>

  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.30 0.20 0.10"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.30 0.20 0.10"/></geometry>
    </collision>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Wheels:
       - Cylinder axis is +Z by default, so rotate wheel visuals -90deg about X to make axis +Y (left-right axle).
       - Joint axis set to +Y so wheels spin like a real car.
       - No extra joint yaw rotation (keeps frames consistent).
  -->

  <link name="wheel_fl">
    <visual>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
    </collision>
  </link>

  <link name="wheel_fr">
    <visual>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
    </collision>
  </link>

  <link name="wheel_rl">
    <visual>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
    </collision>
  </link>

  <link name="wheel_rr">
    <visual>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
    </collision>
  </link>

  <!-- Wheel joints (positions unchanged, rpy removed, axis set to +Y) -->
  <joint name="wheel_fl_joint" type="continuous">
    <parent link="chassis_link"/>
    <child link="wheel_fl"/>
    <origin xyz="0.11 0.06 0.00" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="wheel_fr_joint" type="continuous">
    <parent link="chassis_link"/>
    <child link="wheel_fr"/>
    <origin xyz="0.11 -0.06 0.00" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="wheel_rl_joint" type="continuous">
    <parent link="chassis_link"/>
    <child link="wheel_rl"/>
    <origin xyz="-0.11 0.06 0.00" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="wheel_rr_joint" type="continuous">
    <parent link="chassis_link"/>
    <child link="wheel_rr"/>
    <origin xyz="-0.11 -0.06 0.00" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- LiDAR -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.05"/></geometry>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.08 0 0.12" rpy="0 0 0"/>
  </joint>

</robot>
