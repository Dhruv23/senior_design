<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="scu2u_rover">
    <static>false</static>

    <!-- Chassis -->
    <link name="chassis_link">
      <pose>0 0 0 0 0 0</pose>

      <visual name="chassis_visual">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <box><size>0.30 0.20 0.10</size></box>
        </geometry>
      </visual>

      <collision name="chassis_collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <box><size>0.30 0.20 0.10</size></box>
        </geometry>
      </collision>

      <!-- Give it some inertia so physics is stable -->
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- LiDAR link (mounted on chassis like your URDF: 0.08 0 0.12 relative to base) -->
    <link name="lidar_link">
      <pose>0.08 0 0.12 0 0 0</pose>

      <visual name="lidar_visual">
        <geometry>
          <cylinder><radius>0.03</radius><length>0.05</length></cylinder>
        </geometry>
      </visual>

      <!-- 360° CPU ray LiDAR -->
      <sensor name="lidar_2d" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>5</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>chassis_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- Wheels (simple visuals; you can add joints/drive later) -->
    <link name="wheel_fl">
      <pose>0.11 0.06 0.00 0 0 0</pose>
      <visual name="wheel_fl_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.04</radius><length>0.02</length></cylinder>
        </geometry>
      </visual>
    </link>

    <link name="wheel_fr">
      <pose>0.11 -0.06 0.00 0 0 0</pose>
      <visual name="wheel_fr_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.04</radius><length>0.02</length></cylinder>
        </geometry>
      </visual>
    </link>

    <link name="wheel_rl">
      <pose>-0.11 0.06 0.00 0 0 0</pose>
      <visual name="wheel_rl_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.04</radius><length>0.02</length></cylinder>
        </geometry>
      </visual>
    </link>

    <link name="wheel_rr">
      <pose>-0.11 -0.06 0.00 0 0 0</pose>
      <visual name="wheel_rr_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.04</radius><length>0.02</length></cylinder>
        </geometry>
      </visual>
    </link>

    <!-- Fix wheels to chassis for now (later we’ll make continuous joints and diff-drive) -->
    <joint name="wheel_fl_joint" type="fixed">
      <parent>chassis_link</parent><child>wheel_fl</child>
    </joint>
    <joint name="wheel_fr_joint" type="fixed">
      <parent>chassis_link</parent><child>wheel_fr</child>
    </joint>
    <joint name="wheel_rl_joint" type="fixed">
      <parent>chassis_link</parent><child>wheel_rl</child>
    </joint>
    <joint name="wheel_rr_joint" type="fixed">
      <parent>chassis_link</parent><child>wheel_rr</child>
    </joint>

  </model>
</sdf>
