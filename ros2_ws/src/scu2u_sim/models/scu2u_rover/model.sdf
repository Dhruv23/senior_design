<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="simple_rover">

    <!-- body -->
    <link name="base_link">
      <pose>0 0 0.10 0 0 0</pose> <!-- Lowering the base link to adjust center of mass -->

      <collision name="col">
        <geometry>
          <box><size>0.45 0.30 0.12</size></box>
        </geometry>
      </collision>

      <visual name="vis">
        <geometry>
          <box><size>0.45 0.30 0.12</size></box>
        </geometry>
      </visual>

      <inertial>
        <mass>1000.0</mass> <!-- Increased mass significantly -->
      </inertial>
    </link>

    <!-- LiDAR link -->
    <link name="lidar_link">
      <pose>0.18 0 0.20 0 0 0</pose> <!-- Positioning LiDAR 0.2m above the rover -->
      <inertial><mass>0.1</mass></inertial>

      <visual name="vis">
        <geometry>
          <cylinder><radius>0.03</radius><length>0.02</length></cylinder> <!-- Visual appearance of the LiDAR -->
        </geometry>
      </visual>

      <sensor name="lidar" type="ray"> <!-- Set the sensor type as ray -->
        <always_on>true</always_on>
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <topic>/scan</topic> <!-- ROS 2 topic for publishing LiDAR data -->
        <visualize>true</visualize>

        <ray>
          <scan>
            <horizontal>
              <samples>720</samples> <!-- Number of samples (resolution) -->
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle> <!-- Field of view start angle -->
              <max_angle>3.14159</max_angle> <!-- Field of view end angle -->
            </horizontal>
          </scan>
          <range>
            <min>0.12</min> <!-- Minimum range (0.12 meters) -->
            <max>12.0</max> <!-- Maximum range (12 meters) -->
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </link>

    <!-- LiDAR Joint -->
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- LiDAR Plugin for ROS 2 Integration -->
    <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_lidar.so">
      <sensor_name>lidar</sensor_name>
      <frame_id>laser</frame_id>
      <topic>/scan</topic> <!-- ROS 2 topic for LiDAR data -->
      <visualize>true</visualize> <!-- Enable ray visualization -->
    </plugin>

    <!-- Wheel surface params -->
    <!-- wheel radius=0.06, length=0.03 -->
    <!-- IMPORTANT: cylinder axis is local Z; we rotate collision+visual by +90deg about X -->
    <!-- Wheel link poses are NOT rotated; only the geometry is rotated. -->

    <!-- Front Left Wheel -->
    <link name="front_left_wheel">
      <pose>0.15 0.18 0.06 0 0 0</pose>

      <collision name="col">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.06</radius><length>0.03</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.7</mu><mu2>0.7</mu2></ode> <!-- Reduced friction -->
          </friction>
          <contact>
            <ode>
              <kp>100000</kp> <!-- Reduced stiffness -->
              <kd>50</kd>     <!-- Reduced damping -->
              <min_depth>0.001</min_depth>
              <max_vel>0.1</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="vis">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.06</radius><length>0.03</length></cylinder>
        </geometry>
      </visual>

      <inertial><mass>10.0</mass></inertial> <!-- Increased wheel mass -->
    </link>

    <!-- Rear Left Wheel -->
    <link name="rear_left_wheel">
      <pose>-0.15 0.18 0.06 0 0 0</pose>

      <collision name="col">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.06</radius><length>0.03</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.7</mu><mu2>0.7</mu2></ode> <!-- Reduced friction -->
          </friction>
          <contact>
            <ode>
              <kp>100000</kp> <!-- Reduced stiffness -->
              <kd>50</kd>     <!-- Reduced damping -->
              <min_depth>0.001</min_depth>
              <max_vel>0.1</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="vis">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.06</radius><length>0.03</length></cylinder>
        </geometry>
      </visual>

      <inertial><mass>10.0</mass></inertial> <!-- Increased wheel mass -->
    </link>

    <!-- Front Right Wheel -->
    <link name="front_right_wheel">
      <pose>0.15 -0.18 0.06 0 0 0</pose>

      <collision name="col">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.06</radius><length>0.03</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.7</mu><mu2>0.7</mu2></ode> <!-- Reduced friction -->
          </friction>
          <contact>
            <ode>
              <kp>100000</kp> <!-- Reduced stiffness -->
              <kd>50</kd>     <!-- Reduced damping -->
              <min_depth>0.001</min_depth>
              <max_vel>0.1</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="vis">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.06</radius><length>0.03</length></cylinder>
        </geometry>
      </visual>

      <inertial><mass>10.0</mass></inertial> <!-- Increased wheel mass -->
    </link>

    <!-- Rear Right Wheel -->
    <link name="rear_right_wheel">
      <pose>-0.15 -0.18 0.06 0 0 0</pose>

      <collision name="col">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.06</radius><length>0.03</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.7</mu><mu2>0.7</mu2></ode> <!-- Reduced friction -->
          </friction>
          <contact>
            <ode>
              <kp>100000</kp> <!-- Reduced stiffness -->
              <kd>50</kd>     <!-- Reduced damping -->
              <min_depth>0.001</min_depth>
              <max_vel>0.1</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="vis">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.06</radius><length>0.03</length></cylinder>
        </geometry>
      </visual>

      <inertial><mass>10.0</mass></inertial> <!-- Increased wheel mass -->
    </link>

    <!-- wheel joints: axle is +/-Y -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>50</effort>
          <velocity>50</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>50</effort>
          <velocity>50</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz> <!-- Corrected to use Y-axis for rotation -->
        <limit>
          <effort>50</effort>
          <velocity>50</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz> <!-- Corrected to use Y-axis for rotation -->
        <limit>
          <effort>50</effort>
          <velocity>50</velocity>
        </limit>
      </axis>
    </joint>

    <!-- 4-wheel skid-steer using DiffDrive -->
    <!-- Front axle diff drive -->
    <plugin filename="libgz-sim-diff-drive-system.so"
            name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <wheel_separation>0.36</wheel_separation>  <!-- Distance between front and rear wheels -->
      <wheel_radius>0.06</wheel_radius>          <!-- Radius of the wheels -->
      <topic>cmd_vel_front</topic>
    </plugin>

    <!-- Rear axle diff drive -->
    <plugin filename="libgz-sim-diff-drive-system.so"
            name="gz::sim::systems::DiffDrive">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.36</wheel_separation>  <!-- Distance between front and rear wheels -->
      <wheel_radius>0.06</wheel_radius>          <!-- Radius of the wheels -->
      <topic>cmd_vel_rear</topic>
    </plugin>

  </model>
</sdf>
